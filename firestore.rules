rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function mail() { return request.auth.token.email.lower(); }
    function logueado() { return request.auth != null && request.auth.token.email != null; }

    // Perfil del personal: el documento de "users" tiene como ID el email en minúsculas.
    function perfil() { return get(/databases/$(database)/documents/users/$(mail())).data; }
    function esPersonal() {
      return logueado()
        && exists(/databases/$(database)/documents/users/$(mail()))
        && perfil().activo == true;
    }
    function esSenior() { return esPersonal() && perfil().rol_jerarquia == 'senior'; }

    function clienteDe(id) { return get(/databases/$(database)/documents/clients/$(id)).data; }
    function esDueno(clienteId) { return logueado() && clienteDe(clienteId).usuario_id.lower() == mail(); }

    // Personal: cada uno lee su propio perfil; todo el personal ve a los demás.
    // Solo un Profesional Senior da de alta, cambia nivel o da de baja.
    match /users/{id} {
      allow get: if logueado() && (id == mail() || esPersonal());
      allow list: if esPersonal();
      allow create, update, delete: if esSenior();
    }

    // Clientes: el personal gestiona todo; el cliente ve solo su ficha.
    match /clients/{id} {
      allow read: if esPersonal() || (logueado() && resource.data.usuario_id.lower() == mail());
      allow write: if esPersonal();
    }

    match /tasks/{id} {
      allow read, write: if esPersonal();
    }

    // Documentos: personal total; el cliente ve y sube solo los de su ficha.
    match /documents/{id} {
      allow read: if esPersonal() || esDueno(resource.data.cliente_id);
      allow create: if esPersonal() || esDueno(request.resource.data.cliente_id);
      allow update, delete: if esPersonal();
    }

    match /entregas/{id} {
      allow read: if esPersonal() || esDueno(resource.data.cliente_id);
      allow create, update: if esPersonal();
      allow delete: if esSenior();
    }

    match /mensajes/{id} {
      allow read, write: if esPersonal();
    }
  }
}
